<UserControl x:Class="Nexora.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Nexora.Services"
    Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ProfileActionButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="86"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#132B47"/>
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="#367FCE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#183A60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProfileValueText" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#DCEBFA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        </Style>
        <Style x:Key="ProfileBadgeCopyText" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B9CAE2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ProfileSmallCopyText" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ProfileDriveTile" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinWidth" Value="245"/>
            <Setter Property="Height" Value="108"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DriveBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Path Data="M 0,0 L 5,5 L 0,10"
                                      Stroke="#78B9F5"
                                      StrokeThickness="1.8"
                                      Width="6"
                                      Height="11"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DriveBorder" Property="Background" Value="#132B47"/>
                                <Setter TargetName="DriveBorder" Property="BorderBrush" Value="#367FCE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DriveBorder" Property="Background" Value="#183A60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProfileCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EEF5FF"/>
        </Style>
        <Style x:Key="ProfileBadge" TargetType="Border">
            <Setter Property="Background" Value="#10233A"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel Margin="36,28,36,42">
            <Border Height="170" MinHeight="170" CornerRadius="16" BorderBrush="#174C8D" BorderThickness="1" Padding="20" Margin="0,0,0,18">
                <Border.Background><ImageBrush ImageSource="/interface/other/banner.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Border.Background>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="{local:SvgImage Source=interface/other/windows-svgrepo-com.svg}" Width="72" Height="72" Stretch="Uniform" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="Профиль" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left"/>
                        <TextBlock Text="Информация о пользователе и компьютере в одном месте." Foreground="#B9CAE2" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Профиль" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Профиль пользователя и сводная информация о компьютере."
                               FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="Обновить сведения" Click="RefreshHardware_Click" Style="{StaticResource GhostButton}"/>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="72" Height="72" CornerRadius="36" Background="#176BE0">
                        <TextBlock x:Name="UserInitialText" FontSize="34" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText" FontSize="23" FontWeight="SemiBold"/>
                        <TextBox x:Name="UserAccountText" Style="{StaticResource ProfileSmallCopyText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Система" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right"/>
                        <TextBox x:Name="SystemSummaryText" FontSize="15" FontWeight="SemiBold"
                                 Style="{StaticResource ProfileSmallCopyText}"
                                 HorizontalAlignment="Right"
                                 TextAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Сведения о системе" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,12"/>
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,8,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{local:SvgImage Source=interface/white/brand-windows.svg}" Width="21" Height="21" Margin="0,0,9,0"/>
                            <TextBlock Text="Windows" Style="{StaticResource ProfileCardTitle}"/>
                        </StackPanel>
                        <TextBox x:Name="SystemText" Style="{StaticResource ProfileValueText}" Margin="0,10,0,5"/>
                        <WrapPanel>
                            <Border Style="{StaticResource ProfileBadge}"><TextBox x:Name="WindowsVersionText" Style="{StaticResource ProfileBadgeCopyText}"/></Border>
                            <Border Style="{StaticResource ProfileBadge}"><TextBox x:Name="ArchitectureText" Style="{StaticResource ProfileBadgeCopyText}"/></Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18" Margin="8,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{local:SvgImage Source=interface/white/icons8-memory-50.svg}" Width="21" Height="21" Margin="0,0,9,0"/>
                            <TextBlock Text="Оперативная память" Style="{StaticResource ProfileCardTitle}"/>
                        </StackPanel>
                        <TextBox x:Name="MemoryText" Style="{StaticResource ProfileValueText}" Margin="0,10,0,5"/>
                        <TextBlock Text="Объём установленной памяти" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,8,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{local:SvgImage Source=interface/white/cpu.svg}" Width="21" Height="21" Margin="0,0,9,0"/>
                            <TextBlock Text="Процессор" Style="{StaticResource ProfileCardTitle}"/>
                        </StackPanel>
                        <TextBox x:Name="CpuText" Style="{StaticResource ProfileValueText}" Margin="0,10,0,5"/>
                        <WrapPanel>
                            <Border Style="{StaticResource ProfileBadge}"><TextBox x:Name="CpuCoresText" Style="{StaticResource ProfileBadgeCopyText}"/></Border>
                            <Border Style="{StaticResource ProfileBadge}"><TextBox x:Name="CpuThreadsText" Style="{StaticResource ProfileBadgeCopyText}"/></Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18" Margin="8,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{local:SvgImage Source=interface/white/icons8-videocard-50.svg}" Width="21" Height="21" Margin="0,0,9,0"/>
                            <TextBlock Text="Видеокарта" Style="{StaticResource ProfileCardTitle}"/>
                        </StackPanel>
                        <TextBox x:Name="GpuText" Style="{StaticResource ProfileValueText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,8,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{local:SvgImage Source=interface/white/icons8-motherboard-50.svg}" Width="21" Height="21" Margin="0,0,9,0"/>
                            <TextBlock Text="Материнская плата" Style="{StaticResource ProfileCardTitle}"/>
                        </StackPanel>
                        <TextBox x:Name="MotherboardText" Style="{StaticResource ProfileValueText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18" Margin="8,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{local:SvgImage Source=interface/white/package.svg}" Width="21" Height="21" Margin="0,0,9,0"/>
                            <TextBlock Text="Накопители" Style="{StaticResource ProfileCardTitle}"/>
                        </StackPanel>
                        <ItemsControl x:Name="DrivesControl" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ProfileDriveTile}" Tag="{Binding}" Click="DriveTile_Click">
                                        <StackPanel Width="215">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="30" Height="30" CornerRadius="8" Background="#18385E" Padding="7" Margin="0,0,8,0">
                                                    <Image Source="{local:SvgImage Source=interface/white/package.svg}" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" MaxWidth="175"/>
                                                    <TextBlock Text="{Binding Path}" Foreground="#7290B2" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding UsageText}" Foreground="#B9CAE2" FontSize="12" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
