<UserControl x:Class="WpfApp1.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ProfileValueTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#DCEBFA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="SelectionBrush" Value="#347FCE"/>
            <Setter Property="SelectionOpacity" Value="0.85"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="ProfileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EEF5FF"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,42">
            <TextBlock Text="Профиль" FontSize="32" FontWeight="Bold"/>
            <TextBlock Text="Ваш профиль и информация о компьютере." FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,22"/>
            <Border Style="{StaticResource Card}" Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="110" Height="110" CornerRadius="55" Background="#176BE0"><TextBlock x:Name="UserInitialText" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                        <TextBox x:Name="UserNameText" Style="{StaticResource ProfileValueTextBox}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Пользователь Windows" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14"/>
                        <TextBox x:Name="UserAccountText" Style="{StaticResource ProfileValueTextBox}" Foreground="#AFC5DD" Margin="0,4"/>
                        <Button x:Name="PcDetailsButton" Content="Показать сведения о ПК" Click="PcDetails_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel x:Name="PcInfoPanel" Visibility="Collapsed">
                <TextBlock Text="Сведения о ПК" FontSize="21" FontWeight="SemiBold" Margin="0,24,0,12"/>
                <UniformGrid Columns="2" Margin="-4">
                    <Border Style="{StaticResource Card}" Padding="18" Margin="4"><StackPanel><StackPanel Orientation="Horizontal"><Image x:Name="SystemIcon" Width="22" Height="22" Margin="0,0,9,0"/><TextBlock Text="Система" Style="{StaticResource ProfileLabel}" VerticalAlignment="Center"/></StackPanel><TextBox x:Name="SystemText" Style="{StaticResource ProfileValueTextBox}" Margin="0,12,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="4"><StackPanel><StackPanel Orientation="Horizontal"><Image x:Name="MemoryIcon" Width="22" Height="22" Margin="0,0,9,0"/><TextBlock Text="Оперативная память" Style="{StaticResource ProfileLabel}" VerticalAlignment="Center"/></StackPanel><TextBox x:Name="MemoryText" Style="{StaticResource ProfileValueTextBox}" Margin="0,12,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="4"><StackPanel><StackPanel Orientation="Horizontal"><Image x:Name="CpuIcon" Width="22" Height="22" Margin="0,0,9,0"/><TextBlock Text="Процессор" Style="{StaticResource ProfileLabel}" VerticalAlignment="Center"/></StackPanel><TextBox x:Name="CpuText" Style="{StaticResource ProfileValueTextBox}" Margin="0,12,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="4"><StackPanel><StackPanel Orientation="Horizontal"><Image x:Name="GpuIcon" Width="22" Height="22" Margin="0,0,9,0"/><TextBlock Text="Видеокарта" Style="{StaticResource ProfileLabel}" VerticalAlignment="Center"/></StackPanel><TextBox x:Name="GpuText" Style="{StaticResource ProfileValueTextBox}" Margin="0,12,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="4"><StackPanel><StackPanel Orientation="Horizontal"><Image x:Name="MotherboardIcon" Width="22" Height="22" Margin="0,0,9,0"/><TextBlock Text="Материнская плата" Style="{StaticResource ProfileLabel}" VerticalAlignment="Center"/></StackPanel><TextBox x:Name="MotherboardText" Style="{StaticResource ProfileValueTextBox}" Margin="0,12,0,0"/></StackPanel></Border>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
