<UserControl x:Class="Nexora.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Nexora.Services"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,42">
            <Border Height="170" MinHeight="170" CornerRadius="16" BorderBrush="#174C8D" BorderThickness="1" Padding="20" Margin="0,0,0,18">
                <Border.Background><ImageBrush ImageSource="/interface/other/banner.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Border.Background>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="{local:SvgImage Source=interface/other/windows-svgrepo-com.svg}" Width="72" Height="72" Stretch="Uniform" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left"/>
                        <TextBlock Text="Настройте внешний вид, язык и параметры приложения." Foreground="#B9CAE2" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="Настройки" FontSize="32" FontWeight="Bold"/>
            <TextBlock Text="Внешний вид, язык и параметры загрузок." FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,22"/>
            
<Border Style="{StaticResource Card}" Padding="22">
 <StackPanel>
  <TextBlock Text="Внешний вид" FontSize="19" FontWeight="SemiBold"/>
  <TextBlock Text="Тёмная тема" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
  <CheckBox Content="Использовать тёмную тему" IsChecked="True" Foreground="#F1F6FF" Margin="0,0,0,20"/>
  <TextBlock Text="Язык" FontSize="19" FontWeight="SemiBold"/>
  <ComboBox Width="220" HorizontalAlignment="Left" SelectedIndex="0" Margin="0,8,0,20"><ComboBoxItem>Русский</ComboBoxItem><ComboBoxItem>English</ComboBoxItem></ComboBox>
 </StackPanel>
</Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
