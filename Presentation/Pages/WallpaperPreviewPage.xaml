<UserControl x:Class="Nexora.Pages.WallpaperPreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Nexora.Services"
    Background="Transparent" Focusable="True" PreviewKeyDown="WallpaperPreviewPage_PreviewKeyDown">
    <Grid>
        <Grid x:Name="PreviewScrollContainer">
            <ScrollViewer x:Name="PreviewScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,28,36,42">
                <TextBlock Text="Просмотр обоев" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="Предпросмотр, информация и действия для выбранного изображения."
                           FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,22"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="←  Назад к обоям" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,10,0"/>
                    <Button Content="⛶  На весь экран" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Click="Fullscreen_Click"/>
                </StackPanel>

                <Border Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="PreviewHost" Height="480" CornerRadius="14" Background="#0B1828"
                                Margin="0,0,24,0" ClipToBounds="True"
                                MouseWheel="PreviewImage_MouseWheel"
                                MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                                MouseMove="PreviewImage_MouseMove"
                                MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"
                                MouseEnter="PreviewHost_MouseEnter"
                                MouseLeave="PreviewHost_MouseLeave">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="PreviewTranslate" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <Button x:Name="PreviousButton" Style="{StaticResource WallpaperNavigationButton}" HorizontalAlignment="Left" Click="PreviousWallpaper_Click" Panel.ZIndex="20">
                                    <Image Source="{local:SvgImage Source=interface/white/back.svg}" Width="17" Height="17"/>
                                </Button>
                                <Button x:Name="NextButton" Style="{StaticResource WallpaperNavigationButton}" HorizontalAlignment="Right" Click="NextWallpaper_Click" Panel.ZIndex="20">
                                    <Image Source="{local:SvgImage Source=interface/white/next.svg}" Width="17" Height="17"/>
                                </Button>
                                <Border x:Name="HintPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                                        Background="#CC07111F" CornerRadius="8" Padding="10,6"
                                        IsHitTestVisible="False" Opacity="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="HintPanelTranslate" Y="18"/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Text="Колесо - приблизить" FontSize="11" Foreground="#D6E1EF"/>
                                        <TextBlock Text="Лкм+перетаскивание - переместить" FontSize="11" Foreground="#D6E1EF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="Обои" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SizeText" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16"/>
                            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,24"/>

                                <Button x:Name="SetButton" Style="{StaticResource PrimaryButton}"
                                    Click="SetWallpaper_Click" Margin="0,0,0,10" Cursor="Hand"/>
                                <Button x:Name="FavoriteButton" Style="{StaticResource GhostButton}"
                                    Click="Favorite_Click" Margin="0,0,0,10"/>
                                <Button x:Name="SaveCopyButton" Style="{StaticResource GhostButton}"
                                    Click="SaveCopy_Click"/>
                            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="FullscreenOverlay" Visibility="Collapsed" Background="#050A11"
              Panel.ZIndex="100" ClipToBounds="True" Focusable="True"
              MouseWheel="FullscreenOverlay_MouseWheel"
              MouseLeftButtonDown="FullscreenOverlay_MouseLeftButtonDown"
              MouseMove="FullscreenOverlay_MouseMove"
              MouseLeftButtonUp="FullscreenOverlay_MouseLeftButtonUp"
              MouseEnter="FullscreenOverlay_MouseEnter"
              MouseLeave="FullscreenOverlay_MouseLeave"
              PreviewKeyDown="FullscreenOverlay_PreviewKeyDown">
                 <Image x:Name="FullscreenImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"
                     IsHitTestVisible="False" Panel.ZIndex="1" SnapsToDevicePixels="False"
                     RenderOptions.BitmapScalingMode="HighQuality" CacheMode="BitmapCache">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="FullscreenScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="FullscreenTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Button x:Name="FullscreenPreviousButton" Style="{StaticResource WallpaperNavigationButton}" HorizontalAlignment="Left" Margin="32" Click="PreviousWallpaper_Click" Panel.ZIndex="20">
                <Image Source="{local:SvgImage Source=interface/white/back.svg}" Width="17" Height="17"/>
            </Button>
            <Button x:Name="FullscreenNextButton" Style="{StaticResource WallpaperNavigationButton}" HorizontalAlignment="Right" Margin="32" Click="NextWallpaper_Click" Panel.ZIndex="20">
                <Image Source="{local:SvgImage Source=interface/white/next.svg}" Width="17" Height="17"/>
            </Button>

                <Border x:Name="FullscreenInfoPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,32"
                    Background="#CC0D1B2E" CornerRadius="12" Padding="16,11"
                    IsHitTestVisible="False" Panel.ZIndex="10">
                <StackPanel>
                    <TextBlock x:Name="FullscreenTitleText" FontSize="17" FontWeight="SemiBold"/>
                    <StackPanel Margin="0,3,0,0">
                        <TextBlock Text="Колесо - приблизить" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="Лкм+перетаскивание - переместить" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="Лкм - скрыть навигацию" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

                <Button x:Name="CloseFullscreenButton" Content="Выйти" Width="170" Height="40"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,32,32,0"
                    Style="{StaticResource GhostButton}" Click="CloseFullscreen_Click" Panel.ZIndex="2000"/>
        </Grid>
    </Grid>
</UserControl>
