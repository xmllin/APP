                                        <ToggleButton x:Name="DisableAppDiagnosticsToggle" Tag="DisableAppDiagnostics" Checked="WindowsFeatureToggle_Changed" Unchecked="WindowsFeatureToggle_Changed" Style="{StaticResource ExplorerToggleButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <TextBlock Text="Запретить сбор и публикацию данных об активности пользователя" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="DisableActivityLabel" Text="Отключено" Foreground="#FF0000" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ToggleButton x:Name="DisableActivityToggle" Tag="DisableActivity" Checked="WindowsFeatureToggle_Changed" Unchecked="WindowsFeatureToggle_Changed" Style="{StaticResource ExplorerToggleButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <TextBlock Text="Запретить сбор данных о производительности системы" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="DisablePerformanceLabel" Text="Отключено" Foreground="#FF0000" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ToggleButton x:Name="DisablePerformanceToggle" Tag="DisablePerformance" Checked="WindowsFeatureToggle_Changed" Unchecked="WindowsFeatureToggle_Changed" Style="{StaticResource ExplorerToggleButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <TextBlock Text="Запретить сбор данных о нажатиях клавиш" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="DisableKeystrokesLabel" Text="Отключено" Foreground="#FF0000" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ToggleButton x:Name="DisableKeystrokesToggle" Tag="DisableKeystrokes" Checked="WindowsFeatureToggle_Changed" Unchecked="WindowsFeatureToggle_Changed" Style="{StaticResource ExplorerToggleButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <TextBlock Text="Запретить обновление голосовых данных" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="DisableVoiceDataLabel" Text="Отключено" Foreground="#FF0000" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ToggleButton x:Name="DisableVoiceDataToggle" Tag="DisableVoiceData" Checked="WindowsFeatureToggle_Changed" Unchecked="WindowsFeatureToggle_Changed" Style="{StaticResource ExplorerToggleButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="ToastNotification" Background="#173A61" BorderBrush="#2B6ECB" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Bottom" Margin="36,0,36,96" MaxWidth="430" HorizontalAlignment="Center" Visibility="Collapsed" Panel.ZIndex="100">
            <TextBlock x:Name="ToastText" Foreground="#F1F6FF" FontSize="13" FontWeight="SemiBold" Text="" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
        <Grid VerticalAlignment="Bottom" Margin="36,0,53,12">
            <Border Background="#0B2035" BorderBrush="#1D3B5A" BorderThickness="1"
                    CornerRadius="11" Padding="14" IsHitTestVisible="False">
            </Border>
            <DockPanel LastChildFill="False" Margin="14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Image Source="{local:SvgImage Source=interface/white/info-circle.svg}" Width="27" Height="23" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Для применения некоторых настроек требуется перезапуск проводника" Foreground="#85A8D2" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="RestartSystemButton" Content="Перезапустить Windows" Click="RestartSystemButton_Click" Style="{StaticResource GhostButton}" Background="#102A45" BorderBrush="#3D8FE8" DockPanel.Dock="Right" Padding="10,5" FontSize="12" Margin="18,0,0,0" Width="160"/>
                <Button x:Name="RestartExplorerButton" Content="Перезапустить проводник" Click="RestartExplorerButton_Click" Style="{StaticResource GhostButton}" Background="#102A45" BorderBrush="#3D8FE8" DockPanel.Dock="Right" Padding="10,5" FontSize="12" Margin="18,0,0,0" Width="170"/>
                <Button x:Name="RestartAsAdminButton" Content="Перезапустить от администратора" Click="RestartAsAdminButton_Click" Style="{StaticResource GhostButton}" Background="#102A45" BorderBrush="#3D8FE8" DockPanel.Dock="Right" Padding="10,5" FontSize="12" Margin="18,0,0,0" Height="30" Width="220"/>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
