<UserControl x:Class="WpfApp1.Pages.UwpAppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfApp1.Services"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="UwpAppItemTemplate">
            <Border Background="Transparent" Padding="4,3" Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  IsEnabled="{Binding IsInstalled}"
                                  Style="{DynamicResource UwpToggleButton}"
                                  Tag="{Binding}"/>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#8A8A8A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="UwpToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleTrack" Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="12">
                            <Ellipse x:Name="ToggleThumb" Width="14" Height="14" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="#58AEFF"/>
                                <Setter TargetName="ToggleThumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="#173A65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#666666"/>
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="#666666"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0" Panel.ZIndex="0">
            <StackPanel Margin="36,28,36,0">
                <Border Height="150" CornerRadius="16" BorderBrush="#174C8D" BorderThickness="1" Padding="28" Margin="0,0,0,12">
                    <Border.Background>
                        <ImageBrush ImageSource="/interface/other/banner.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{local:SvgImage Source=interface/other/windows-svgrepo-com.svg}" Width="82" Height="82" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="UWP-приложения Windows" FontSize="30" FontWeight="SemiBold"/>
                            <TextBlock Text="Удаляйте встроенные приложения" Foreground="#B9CAE2" FontSize="15" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="ProgressPanel" Background="#0B2035" BorderBrush="#1D3B5A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Foreground="#DCEBFF" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="LoadingProgressBar"
                                     Height="8"
                                     Margin="0,10,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Foreground="#58AEFF"
                                     Background="#173A61"/>
                    </StackPanel>
                </Border>
                <Grid x:Name="PackagesList" Visibility="Collapsed" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding FirstColumn}" ItemTemplate="{StaticResource UwpAppItemTemplate}"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SecondColumn}" ItemTemplate="{StaticResource UwpAppItemTemplate}"/>
                    <StackPanel Grid.Column="2">
                        <ItemsControl ItemsSource="{Binding ThirdColumn}" ItemTemplate="{StaticResource UwpAppItemTemplate}"/>
                        <Border HorizontalAlignment="Right" Margin="0,22,0,0"
                                Background="#0B2035" BorderBrush="#1D3B5A" BorderThickness="1"
                                CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Выберите приложения для удаления" Foreground="#82A5CF"
                                           HorizontalAlignment="Right" Margin="0,0,0,5"/>
                                <Button x:Name="RemoveButton" Content="Начать удаление UWP" Click="RemoveButton_Click"
                                        Style="{StaticResource GhostButton}" Width="200" Height="34"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
