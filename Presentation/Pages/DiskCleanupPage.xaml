<UserControl x:Class="WpfApp1.Pages.DiskCleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WpfApp1.Services"
    Background="Transparent">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="32,26,32,38">
            <Border Height="170" MinHeight="170" CornerRadius="16" BorderBrush="#174C8D" BorderThickness="1" Padding="28" Margin="0,0,0,18">
                <Border.Background><ImageBrush ImageSource="/interface/other/banner.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Border.Background>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="{local:SvgImage Source=interface/other/windows-svgrepo-com.svg}" Width="72" Height="72" Stretch="Uniform" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Очистка диска" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="Очистите временные файлы и освободите место на диске." Foreground="#B9CAE2" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Очистка диска" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Сканирует несколько источников мусора и показывает, сколько места можно освободить."
                                   FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="ScanButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="Сканировать"
                            Click="ScanButton_Click"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Выбрано" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBlock x:Name="SummaryText" Text="0 Б" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SummaryDetailsText" Text="0 элементов · 0 файлов" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Выбрать всё" Click="SelectAll_Click" Style="{StaticResource GhostButton}" Margin="8,0"/>
                        <Button Grid.Column="2" Content="Очистить выбранное" Click="CleanSelected_Click" Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </Border>

                <ItemsControl x:Name="CleanupItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasData}"/>

                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="9"
                                            Background="#10233A" Margin="0,0,12,0">
                                        <Image Width="20" Height="20"
                                               Source="{local:SvgImage Source=interface/white/package.svg}"/>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#91A8C5" FontSize="12" TextWrapping="Wrap" Margin="0,3,12,0"/>
                                        <TextBlock Text="{Binding Path}" Foreground="#58718F" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" Margin="0,3,12,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"/>
                                        <Button Content="Очистить"
                                                Click="CleanItem_Click"
                                                Tag="{Binding}"
                                                Style="{StaticResource GhostButton}"
                                                Margin="0,8,0,0"
                                                Padding="12,7"
                                                IsEnabled="{Binding ActionVisible}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="PageStatusText" Text="Подготовка…" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
