<UserControl x:Class="Nexora.Pages.DiskCleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Nexora.Services"
    Background="Transparent">
    <Grid>
        <ScrollViewer x:Name="CleanupScrollViewer" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="36,28,36,42">
                <Border Height="170" MinHeight="170" CornerRadius="16" BorderBrush="#174C8D" BorderThickness="1" Padding="20" Margin="0,0,0,18" HorizontalAlignment="Stretch">
                    <Border.Background><ImageBrush ImageSource="/interface/other/banner.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Border.Background>
                    <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{local:SvgImage Source=interface/white/disk-cleanup.svg}" Width="72" Height="72" Stretch="Uniform" Margin="0,0,16,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBlock Text="Очистка диска" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left"/><TextBlock Text="Очистите временные файлы и освободите место на диске." Foreground="#B9CAE2" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid>
                </Border>
                <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Очистка диска" FontSize="30" FontWeight="Bold"/><TextBlock Text="Сканирует несколько источников мусора и показывает, сколько места можно освободить." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" x:Name="ScanButton" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Сканировать" Click="ScanButton_Click" Style="{StaticResource PrimaryButton}" Cursor="Hand"/></Grid>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="Выбрано" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="SummaryText" Text="0 Б" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock x:Name="SummaryDetailsText" Text="0 элементов · 0 файлов" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel><Button Grid.Row="0" Grid.Column="1" Content="Выбрать всё" Click="SelectAll_Click" Style="{StaticResource GhostButton}" Margin="8,0" Cursor="Hand" Padding="9,4" Height="28" MinWidth="92"/><Button Grid.Row="0" Grid.Column="2" Content="Очистить выбранное" Click="CleanSelected_Click" Style="{StaticResource PrimaryButton}" Cursor="Hand" Padding="9,4" Height="28" MinWidth="135"/><Border x:Name="PageStatusHost" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Background="#0C1D30" BorderBrush="#21476E" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,14,0,0"><TextBlock x:Name="PageStatusText" Text="Подготовка…" Foreground="#B9CAE2" FontSize="12" TextWrapping="Wrap"/></Border></Grid></Border>
                <ItemsControl x:Name="CleanupItemsControl"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CleanupItemCard}" MouseLeftButtonUp="CleanupItemCard_MouseLeftButtonUp"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="9" Background="#10233A" Margin="0,0,12,0"><Image Width="20" Height="20" Source="{local:SvgImage Source=interface/white/folder.svg}"/></Border><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Text="{Binding SizeText}" Foreground="#8DB6E3" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Grid><TextBlock Text="{Binding Description}" Foreground="#9DB6D4" FontSize="13" TextWrapping="Wrap" Margin="50,5,12,0"/><TextBlock Text="{Binding Path}" Foreground="#6888AB" FontSize="12" TextTrimming="CharacterEllipsis" Margin="50,3,12,0"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="50,5,0,0"/></StackPanel><Grid Grid.Column="1" MinWidth="106" VerticalAlignment="Stretch"><Button Tag="{Binding}" Click="CleanupMoreButton_Click" Style="{StaticResource CleanupMoreButton}" HorizontalAlignment="Right" VerticalAlignment="Top"><Image Source="{local:SvgImage Source=interface/white/dots.svg}" Width="18" Height="18"/><Button.ContextMenu><ContextMenu Style="{StaticResource CleanupContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Style="{StaticResource CleanupMenuItem}" Header="Открыть папку" Click="OpenCleanupFolder_Click" Tag="{Binding}"/></ContextMenu></Button.ContextMenu></Button><Button Content="Очистить" Click="CleanItem_Click" Tag="{Binding}" Style="{StaticResource CleanupCleanButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsEnabled="{Binding ActionVisible}"/></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>