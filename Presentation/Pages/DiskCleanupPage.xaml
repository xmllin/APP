<UserControl x:Class="Nexora.Pages.DiskCleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Nexora.Services"
    Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="CleanupItemCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#132B47"/>
                    <Setter Property="BorderBrush" Value="#367FCE"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#123B2A"/>
                    <Setter Property="BorderBrush" Value="#2ED573"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CleanupCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="24" Height="24">
                            <Border x:Name="CheckBoxBorder"
                                    Width="22" Height="22"
                                    CornerRadius="6"
                                    Background="#0F2237"
                                    BorderBrush="#36516E"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Path x:Name="CheckMark"
                                  Data="M 4,11 L 9,16 L 19,6"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#1F9E64"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#2ED573"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#64B5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="CheckMark" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="36,28,36,42">
            <Border Height="170" MinHeight="170" CornerRadius="16" BorderBrush="#174C8D" BorderThickness="1" Padding="20" Margin="0,0,0,18">
                <Border.Background><ImageBrush ImageSource="/interface/other/banner.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Border.Background>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="{local:SvgImage Source=interface/other/windows-svgrepo-com.svg}" Width="72" Height="72" Stretch="Uniform" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="Очистка диска" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left"/>
                        <TextBlock Text="Очистите временные файлы и освободите место на диске." Foreground="#B9CAE2" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Очистка диска" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Сканирует несколько источников мусора и показывает, сколько места можно освободить."
                                   FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="ScanButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="Сканировать"
                            Click="ScanButton_Click"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Выбрано" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBlock x:Name="SummaryText" Text="0 Б" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SummaryDetailsText" Text="0 элементов · 0 файлов" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Выбрать всё" Click="SelectAll_Click" Style="{StaticResource GhostButton}" Margin="8,0" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="Очистить выбранное" Click="CleanSelected_Click" Style="{StaticResource PrimaryButton}" Cursor="Hand"/>
                    </Grid>
                </Border>

                <ItemsControl x:Name="CleanupItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CleanupItemCard}" MouseLeftButtonUp="CleanupItemCard_MouseLeftButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasData}"
                                              Style="{StaticResource CleanupCheckBox}"/>

                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="9"
                                            Background="#10233A" Margin="0,0,12,0">
                                        <Image Width="20" Height="20"
                                               Source="{local:SvgImage Source=interface/white/package.svg}"/>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#9DB6D4" FontSize="13" TextWrapping="Wrap" Margin="0,3,12,0"/>
                                        <TextBlock Text="{Binding Path}" Foreground="#6888AB" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,12,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Content="Очистить"
                                                Click="CleanItem_Click"
                                                Tag="{Binding}"
                                                Style="{StaticResource GhostButton}"
                                                Cursor="Hand"
                                                Margin="0,8,0,0"
                                                Padding="12,7"
                                                IsEnabled="{Binding ActionVisible}"/>
                                        <Button Click="OpenCleanupFolder_Click"
                                                Tag="{Binding}"
                                                Style="{StaticResource GhostButton}"
                                                Cursor="Hand"
                                                Margin="0,6,0,0"
                                                Padding="12,7">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{local:SvgImage Source=interface/white/fluent-folder-open.svg}" Width="15" Height="15" Margin="0,0,6,0"/>
                                                <TextBlock Text="Открыть папку"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="PageStatusText" Text="Подготовка…" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
