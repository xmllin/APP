<UserControl x:Class="Nexora.Pages.DiskCleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Nexora.Services"
    Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="CleanupContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#10233A"/>
            <Setter Property="BorderBrush" Value="#31516E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="TextElement.Foreground" Value="#F1F6FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#10233A" BorderBrush="#31516E" BorderThickness="1" CornerRadius="6" Padding="4">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanupMenuItem" TargetType="MenuItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBorder" Background="Transparent" CornerRadius="6" Padding="4">
                            <ContentPresenter ContentSource="Header" Margin="6,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#1B4D7A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanupMoreButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MoreBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MoreBorder" Property="Background" Value="#173250"/>
                                <Setter TargetName="MoreBorder" Property="BorderBrush" Value="#367FCE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MoreBorder" Property="Background" Value="#21496F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanupCleanButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CleanBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CleanBorder" Property="Background" Value="#173250"/>
                                <Setter TargetName="CleanBorder" Property="BorderBrush" Value="#367FCE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CleanBorder" Property="Background" Value="#21496F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="CleanBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanupItemCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#132B47"/>
                    <Setter Property="BorderBrush" Value="#367FCE"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#2ED573"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CleanupCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="24" Height="24">
                            <Border x:Name="CheckBoxBorder"
                                    Width="22" Height="22"
                                    CornerRadius="6"
                                    Background="Transparent"
                                    BorderBrush="#2B4B6D"
                                    BorderThickness="1.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Path x:Name="CheckMark"
                                  Data="M 4,11 L 9,16 L 19,6"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#2ED573"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#63FF9A"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#75B9FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="CheckMark" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="36,28,36,42">
            <Border Height="170" MinHeight="170" CornerRadius="16" BorderBrush="#174C8D" BorderThickness="1" Padding="20" Margin="0,0,0,18" HorizontalAlignment="Stretch">
                <Border.Background><ImageBrush ImageSource="/interface/other/banner.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Border.Background>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="{local:SvgImage Source=interface/white/disk-cleanup.svg}" Width="72" Height="72" Stretch="Uniform" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="Очистка диска" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left"/>
                        <TextBlock Text="Очистите временные файлы и освободите место на диске." Foreground="#B9CAE2" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Очистка диска" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Сканирует несколько источников мусора и показывает, сколько места можно освободить."
                                   FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="ScanButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="Сканировать"
                            Click="ScanButton_Click"
                            Style="{StaticResource PrimaryButton}" Cursor="Hand"/>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Выбрано" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBlock x:Name="SummaryText" Text="0 Б" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SummaryDetailsText" Text="0 элементов · 0 файлов" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1" Content="Выбрать всё" Click="SelectAll_Click" Style="{StaticResource GhostButton}" Margin="8,0" Cursor="Hand" Padding="9,4" Height="28" MinWidth="92"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="Очистить выбранное" Click="CleanSelected_Click" Style="{StaticResource PrimaryButton}" Cursor="Hand" Padding="9,4" Height="28" MinWidth="135"/>
                        <Border x:Name="PageStatusHost"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Background="#0C1D30"
                                BorderBrush="#21476E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,7"
                                Margin="0,14,0,0">
                            <TextBlock x:Name="PageStatusText"
                                       Text="Подготовка…"
                                       Foreground="#B9CAE2"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <ItemsControl x:Name="CleanupItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CleanupItemCard}" MouseLeftButtonUp="CleanupItemCard_MouseLeftButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="9"
                                                    Background="#10233A" Margin="0,0,12,0">
                                                <Image Width="20" Height="20"
                                                       Source="{local:SvgImage Source=interface/white/folder.svg}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <CheckBox VerticalAlignment="Center"
                                                          Margin="9,0,0,0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding HasData}"
                                                          Style="{StaticResource CleanupCheckBox}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}" Foreground="#9DB6D4" FontSize="13"
                                                   TextWrapping="Wrap" Margin="50,5,12,0"/>
                                        <TextBlock Text="{Binding Path}" Foreground="#6888AB" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" Margin="50,3,12,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12" Margin="50,5,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="16" FontWeight="SemiBold" Margin="12,0"/>

                                    <Grid Grid.Column="2" MinWidth="106" VerticalAlignment="Stretch">
                                        <Button Tag="{Binding}"
                                                Click="CleanupMoreButton_Click"
                                                Style="{StaticResource CleanupMoreButton}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                            <Image Source="{local:SvgImage Source=interface/white/dots.svg}" Width="18" Height="18"/>
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource CleanupContextMenu}"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Style="{StaticResource CleanupMenuItem}" Header="Открыть папку" Click="OpenCleanupFolder_Click" Tag="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Button Content="Очистить"
                                                Click="CleanItem_Click"
                                                Tag="{Binding}"
                                                Style="{StaticResource CleanupCleanButton}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                IsEnabled="{Binding ActionVisible}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
