<UserControl x:Class="WpfApp1.Pages.WindowsActivationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WpfApp1.Services"
    Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="MakuOsActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="148"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style x:Key="DisabledDarkButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="#10263F"/>
            <Setter Property="Foreground" Value="#58718F"/>
            <Setter Property="BorderBrush" Value="#21496F"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,42">
            <Border Height="150" CornerRadius="16" BorderBrush="#174C8D" BorderThickness="1" Margin="0,0,0,16">
                <Border.Background>
                    <ImageBrush ImageSource="/interface/other/banner.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" Margin="24,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{local:SvgImage Source=interface/other/windows-svgrepo-com.svg}" Width="82" Height="82" Stretch="Uniform" Margin="0,0,20,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Активация Windows" FontSize="30" FontWeight="SemiBold"/>
                            <TextBlock Text="Активируйте Windows с помощью HWID" Foreground="#B9CAE2" FontSize="15" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#0A1D39" BorderBrush="#173A61" BorderThickness="1"
                    CornerRadius="11" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ActivationStatusText"
                                       Text="Проверка..."
                                       FontSize="19"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button x:Name="ActivateWindowsButton"
                                Grid.Column="1"
                                Content="Начать активацию"
                                Click="ActivateWindowsButton_Click"
                                Style="{StaticResource GhostButton}"
                                Padding="12,7"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <ProgressBar x:Name="ActivationProgressBar"
                                 Height="4"
                                 Margin="0,14,0,0"
                                 Visibility="Collapsed"
                                 IsIndeterminate="True"
                                 Foreground="#3FA9F5"
                                 Background="Transparent"
                                 BorderThickness="0"/>
                                        <TextBlock x:Name="DownloadStatusText"
                                                             Foreground="#82A5CF"
                                                             FontSize="11"
                                                             Margin="0,6,0,0"
                                                             Visibility="Collapsed"
                                                             TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="#0A1D39" BorderBrush="#173A61" BorderThickness="1"
                    CornerRadius="11" Padding="20">
                <StackPanel>
                    <TextBlock Text="Официальные ISO-образы Windows"
                               FontSize="20" FontWeight="SemiBold"/>
                      <TextBlock Text="Загрузка с официального сайта Microsoft"
                           Foreground="#82A5CF" FontSize="12" Margin="0,6,0,16" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button x:Name="DownloadWindows11Button"
        Content="Скачать ISO Windows 11"
        Click="DownloadWindows11Button_Click"
        Style="{StaticResource GhostButton}"
        Padding="12,7"
        Margin="0,0,10,10"/>

                        <Button x:Name="DownloadWindows10Button"
        Content="Скачать ISO Windows 10"
        Click="DownloadWindows10Button_Click"
        Style="{StaticResource GhostButton}"
        Padding="12,7"
        Margin="0,0,10,10"/>
                        <Button Content="Windows Lite"
                                IsEnabled="False"
                            Style="{StaticResource DisabledDarkButton}"
                                Padding="12,7" Margin="0,0,10,10"
                                ToolTip="Официального ISO Windows Lite не существует"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="#0A1D39" BorderBrush="#173A61" BorderThickness="1"
                    CornerRadius="11" Padding="20" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Сборки MakuOS" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Скачивание ISO и полный список файлов на Adderly.Top."
                               Foreground="#82A5CF" FontSize="12" Margin="0,6,0,16" TextWrapping="Wrap"/>
                    <Button Content="Открыть сайт со всеми сборками" Tag="https://adderly.top/makuos_legacy"
                            Click="OpenMakuOsBuildButton_Click" Style="{StaticResource GhostButton}"
                            Padding="12,7" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                    <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=MakuOsBuilds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#102744" BorderBrush="#285784" BorderThickness="1" CornerRadius="9" Padding="14" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#82A5CF" FontSize="11" Margin="0,4,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Автоустановка" Tag="{Binding DownloadTag}" Click="DownloadMakuOsFileButton_Click" Style="{StaticResource MakuOsActionButton}"/>
                                            <Button Content="Ручная установка" Tag="{Binding FilesUrl}" Click="OpenMakuOsBuildButton_Click" Style="{StaticResource MakuOsActionButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>