<UserControl x:Class="WpfApp1.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WpfApp1.Services"
    Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="DownloadIconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="actionBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="actionBorder" Property="Background" Value="#173250"/>
                                <Setter TargetName="actionBorder" Property="BorderBrush" Value="#367FCE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="actionBorder" Property="Background" Value="#21496F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,42">
            <Border Height="150" CornerRadius="16" BorderBrush="#174C8D" BorderThickness="1" Padding="28" Margin="0,0,0,18">
                <Border.Background>
                    <ImageBrush ImageSource="/interface/other/banner.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{local:SvgImage Source=interface/other/windows-svgrepo-com.svg}" Width="82" Height="82" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Загрузки" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="Текущие и завершённые загрузки." Foreground="#B9CAE2" FontSize="15" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Папка загрузок" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Выберите место для сохранения файлов" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="DownloadFolderText" Grid.Column="1" IsReadOnly="True"
                             Background="#0A1728" Foreground="White" BorderBrush="#294762"
                             Padding="8" Margin="18,0,10,0" VerticalContentAlignment="Center"
                             TextWrapping="NoWrap" IsTabStop="False"/>
                    <Button Grid.Column="2" Content="Выбрать" Style="{StaticResource GhostButton}"
                            Click="PickFolder_Click" Width="120"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Активные загрузки" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="ActiveDownloads">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#12263F" CornerRadius="10" Padding="12" Margin="0,0,0,8"
                                        BorderBrush="#2A507C" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="34"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Tag="{Binding Key}" Click="PauseResumeDownload_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DownloadIconButton}">
                                                    <Setter Property="Content"><Setter.Value><Image Source="{local:SvgImage Source=interface/white/player-pause.svg}" Width="16" Height="16"/></Setter.Value></Setter>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="ToolTip" Value="Пауза"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                            <Setter Property="Content"><Setter.Value><Image Source="{local:SvgImage Source=interface/white/player-play.svg}" Width="16" Height="16"/></Setter.Value></Setter>
                                                            <Setter Property="ToolTip" Value="Продолжить"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="2" Tag="{Binding Key}" Click="CancelDownload_Click" Style="{StaticResource DownloadIconButton}">
                                            <Image Source="{local:SvgImage Source=interface/white/fluent-dismiss.svg}" Width="16" Height="16"/>
                                        </Button>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding DownloadedText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding SpeedText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        </StackPanel>
                                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="3" Height="8" Margin="0,8,0,0"
                                                     Maximum="100" Value="{Binding ProgressValue}"/>
                                    </Grid>
                                </Border>
</DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="История загрузок" FontSize="18" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="OpenFolder_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Image Source="{local:SvgImage Source=interface/white/fluent-folder-open.svg}" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Открыть папку"/></StackPanel></Button>
                            <Button Click="ClearDownloads_Click" Style="{StaticResource GhostButton}"><StackPanel Orientation="Horizontal"><Image Source="{local:SvgImage Source=interface/white/clock-x.svg}" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Очистить историю загрузок"/></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="DownloadItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#10233A" CornerRadius="10" Padding="14" Margin="0,4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Название" Foreground="{StaticResource MutedBrush}" FontSize="11" Grid.Row="0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Grid.Row="1"/>
                                        <TextBlock Grid.Column="1" Text="Вес" Foreground="{StaticResource MutedBrush}" FontSize="11" Grid.Row="0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center" Grid.Row="1"/>
                                        <TextBlock Grid.Column="2" Text="Итог" Foreground="{StaticResource MutedBrush}" FontSize="11" Grid.Row="0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#5FD381" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1"/>
                                        <Button Grid.RowSpan="2" Grid.Column="3" Tag="{Binding}" Click="DeleteDownload_Click" Style="{StaticResource DownloadIconButton}" Margin="6,0,0,0">
                                            <Image Source="{local:SvgImage Source=interface/white/category-trash.svg}" Width="17" Height="17"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
